# Build artefacts
build/
iso/
ref/
*.o
*.elf
*.dec
.ninja_log
.splache
__pycache__/

# Editor and agent session state, not part of the decompilation.
.opencode/
.vscode/
.idea/

# The psp-gcc toolchain is not committed: it is 125 MB of someone else's build,
# and redistributing a compiler is not this repository's business.  Point
# $TS2PSP_PSPDEV at your own copy; `tools/setup.py` says where it looked.
# progress.md records where the toolchain comes from.
bin/

# The decrypted executable and the source disc stay out of git: they are Maxis
# and EA material, and are re-derived from a disc image the user supplies
# themselves.  Point $TS2PSP_ELF at your own copy; see tools/setup.py.
disks/*
!disks/.gitkeep

# The source disc itself.  It is 1 GB of Maxis/EA data and must never be
# committed - it was, once, which is why this repository's history was squashed
# when the project moved to its public home.
*.iso
*.bin
